{"id": "train-28-001", "text": "Since morning nothing is opening on my phone, WhatsApp also not going, kindly help.", "labels": ["no_internet"], "tags": [], "source": "generated", "generator": "claude-fresh", "batch": "train-28", "persona": {"age": "senior", "comfort": "medium", "variety": "indian", "style": "plain", "typos": "none"}}
