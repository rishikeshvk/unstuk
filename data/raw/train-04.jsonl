{"id": "train-04-077", "text": "When I am reading my son's long WhatsApp message, the screen goes black in between. Then I have to unlock again.", "labels": ["screen_turns_off_fast"], "tags": [], "source": "generated", "generator": "claude-fresh", "batch": "train-04", "persona": {"age": "senior", "comfort": "low", "variety": "indian", "style": "frustrated", "typos": "none"}}
