{"id": "train-04-070", "text": "After the battery became low yesterday the screen has gone dark and even after full charging it is not becoming bright.", "labels": ["screen_too_dim"], "tags": [], "source": "generated", "generator": "claude-fresh", "batch": "train-04", "persona": {"age": "senior", "comfort": "low", "variety": "indian", "style": "frustrated", "typos": "none"}}
