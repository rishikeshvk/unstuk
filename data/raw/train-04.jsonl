{"id": "train-04-068", "text": "On Google Maps I cannot see the road in the daytime, screen is too dark outside.", "labels": ["screen_too_dim"], "tags": [], "source": "generated", "generator": "claude-fresh", "batch": "train-04", "persona": {"age": "senior", "comfort": "low", "variety": "indian", "style": "frustrated", "typos": "none"}}
