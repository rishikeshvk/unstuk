<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (AGENTS.md invariant 7). DUMP is held by the adb shell, not by other apps. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name=".debug.TrialReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.rishikeshvk.unstuk.debug.RUN_ACTION" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".debug.ComplaintReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.rishikeshvk.unstuk.debug.RUN_COMPLAINT" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".debug.AudioSetupReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.rishikeshvk.unstuk.debug.SET_AUDIO" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
